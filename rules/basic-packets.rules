# Demonstrations only: these are packet conditions, not evidence of an attack.
alert icmp any any -> any any (msg:"ICMP echo observed"; itype:8; sid:1000010; rev:1;)
alert tcp any any -> any 80 (msg:"TCP destination port 80 observed"; sid:1000011; rev:1;)
alert udp any any -> any 53 (msg:"UDP destination port 53 observed"; sid:1000012; rev:1;)
